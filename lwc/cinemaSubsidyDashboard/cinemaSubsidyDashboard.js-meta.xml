<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle
    xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>67.0</apiVersion>

    <isExposed>true</isExposed>

    <masterLabel>
        Cinema Subsidy Dashboard
    </masterLabel>

    <description>
        Displays cinema subsidy requests by category,
        approval status, and allows new subsidy requests.
    </description>

    <targets>

        <target>
            lightningCommunity__Page
        </target>

        <target>
            lightningCommunity__Default
        </target>

        <target>
            lightning__RecordPage
        </target>

        <target>
            lightning__AppPage
        </target>

    </targets>

    <targetConfigs>

        <targetConfig
            targets="lightningCommunity__Default">

            <property
                name="permitId"
                type="String"
                label="Permit Application Id"
                description="Optional Permit Application Id. Leave blank to show all accessible subsidies."
            />

        </targetConfig>

    </targetConfigs>

</LightningComponentBundle>