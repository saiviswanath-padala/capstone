<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle
    xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>67.0</apiVersion>

    <isExposed>true</isExposed>

    <masterLabel>
        Cinema Permit Tracker
    </masterLabel>

    <description>
        Tracks a cinema permit application,
        displays progress, raises grievances,
        and uploads supporting documents.
    </description>

    <targets>
        <target>
            lightningCommunity__Page
        </target>

        <target>
            lightningCommunity__Default
        </target>

        <target>
            lightning__RecordPage
        </target>

        <target>
            lightning__AppPage
        </target>
    </targets>

    <targetConfigs>

        <targetConfig
            targets="lightningCommunity__Default">

            <property
                name="permitId"
                type="String"
                label="Permit Application Id"
                description="Optional Permit Application Id. If blank, the component loads the latest accessible permit."
            />

        </targetConfig>

    </targetConfigs>

</LightningComponentBundle>